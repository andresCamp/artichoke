<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Activate / manage the embedded network system extension -->
	<key>com.apple.developer.system-extension.install</key>
	<true/>
	<!-- Manage NEFilterManager configuration -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>content-filter-provider-systemextension</string>
	</array>
	<!-- Shared container + XPC mach service name. $(TeamIdentifierPrefix)
	     is expanded by Xcode from the signing team, so no manual edits. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)dev.serdna.hotspotguard</string>
	</array>
</dict>
</plist>
